# ─── Postgres ─────────────────────────────────────────────
POSTGRES_USER=skillshub
POSTGRES_PASSWORD=skillshub_dev_pw
POSTGRES_DB=skillshub
POSTGRES_PORT=5432

# ─── Backend ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://skillshub:skillshub_dev_pw@postgres:5432/skillshub

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ═══════════════════════════════════════════════════════════
# AI PROVIDERS — fill in keys only for providers you use
# ═══════════════════════════════════════════════════════════

# ─── Anthropic ────────────────────────────────────────────
# Models: claude-opus-4-7 | claude-sonnet-4-6 | claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=sk-ant-...

# ─── Groq (fast, free tier available) ────────────────────
# Models: llama-3.3-70b-versatile | llama-3.1-8b-instant | gemma2-9b-it | mixtral-8x7b-32768
GROQ_API_KEY=gsk_...

# ─── OpenAI ───────────────────────────────────────────────
# Models: gpt-4o | gpt-4o-mini | gpt-4-turbo | o1-mini
OPENAI_API_KEY=sk-...

# ─── Google Gemini ────────────────────────────────────────
# Models: gemini-2.0-flash | gemini-1.5-pro | gemini-1.5-flash
GEMINI_API_KEY=AIza...

# ─── OpenRouter (access any model via one key) ────────────
# Models: any slug from openrouter.ai/models
OPENROUTER_API_KEY=sk-or-...

# ─── Voyage AI (embeddings) ───────────────────────────────
VOYAGE_API_KEY=pa-...

# ═══════════════════════════════════════════════════════════
# ACTIVE LLM — change these two lines to switch providers
# ═══════════════════════════════════════════════════════════
# LLM_PROVIDER must match one of: anthropic | groq | openai | gemini | openrouter
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# ─── Fallback Provider (optional) ─────────────────────────
# Kicks in automatically when the primary provider fails.
# FALLBACK_LLM_PROVIDER=groq
# FALLBACK_LLM_MODEL=llama-3.3-70b-versatile

# ═══════════════════════════════════════════════════════════
# PER-TASK MODEL OVERRIDES (optional)
# Each defaults to LLM_PROVIDER / LLM_MODEL when unset.
# Useful to run heavy tasks on a powerful model while keeping
# cheap tasks on a fast/cheap model.
# ═══════════════════════════════════════════════════════════

# Extraction: PDF → structured profile (accuracy-critical → use a strong model)
EXTRACTION_MODEL=claude-sonnet-4-6
# EXTRACTION_PROVIDER=anthropic

# Re-ranking: score candidates against a query (accuracy-critical)
RERANK_MODEL=claude-sonnet-4-6
# RERANK_PROVIDER=anthropic

# Inference: skill expansion from project context (speed-sensitive)
# INFERENCE_MODEL=
# INFERENCE_PROVIDER=

# Parsing: NL query → structured filters (speed-sensitive)
# PARSING_MODEL=
# PARSING_PROVIDER=

# Light model: fallback for fast/cheap tasks (inference + query parsing)
LIGHT_MODEL=claude-haiku-4-5-20251001

# ─── Embedding Provider ───────────────────────────────────
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3-large

# ─── Frontend ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
