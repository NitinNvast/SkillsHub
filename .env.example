# ─── Postgres ─────────────────────────────────────────────
POSTGRES_USER=skillshub
POSTGRES_PASSWORD=skillshub_dev_pw
POSTGRES_DB=skillshub
POSTGRES_PORT=5432

# ─── Backend ──────────────────────────────────────────────
# Used inside the backend container; host=postgres because docker network
DATABASE_URL=postgresql+asyncpg://skillshub:skillshub_dev_pw@postgres:5432/skillshub

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── AI providers ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...

# Model overrides (optional — sensible defaults in code)
EXTRACTION_MODEL=claude-sonnet-4-6
LIGHT_MODEL=claude-haiku-4-5-20251001
RERANK_MODEL=claude-sonnet-4-6
EMBEDDING_MODEL=voyage-3-large

# ─── Frontend ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
