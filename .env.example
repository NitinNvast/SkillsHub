# ─── Postgres ─────────────────────────────────────────────
POSTGRES_USER=skillshub
POSTGRES_PASSWORD=skillshub_dev_pw
POSTGRES_DB=skillshub
POSTGRES_PORT=5432

# ─── Backend ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://skillshub:skillshub_dev_pw@postgres:5432/skillshub

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ═══════════════════════════════════════════════════════════
# AI PROVIDERS
# ═══════════════════════════════════════════════════════════

# ─── Groq (free tier available) ───────────────────────────
# Get your key at: https://console.groq.com
# Free-tier models: llama-3.3-70b-versatile | llama-3.1-8b-instant | gemma2-9b-it | mixtral-8x7b-32768
GROQ_API_KEY=gsk_...

# ─── Voyage AI (embeddings) ───────────────────────────────
# Required for semantic search (pgvector). Groq has no embeddings endpoint.
# Get your key at: https://dash.voyageai.com
VOYAGE_API_KEY=pa-...

# ═══════════════════════════════════════════════════════════
# LLM CONFIGURATION
# ═══════════════════════════════════════════════════════════
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# ─── Reliability ──────────────────────────────────────────
LLM_TIMEOUT=60
AI_REQUEST_TIMEOUT=60
AI_MAX_RETRIES=2

# ═══════════════════════════════════════════════════════════
# PER-TASK MODEL OVERRIDES (optional)
# Each defaults to LLM_PROVIDER / LLM_MODEL when unset.
# ═══════════════════════════════════════════════════════════

# Extraction: PDF → structured profile (accuracy-critical)
EXTRACTION_MODEL=llama-3.3-70b-versatile

# Re-ranking: score candidates against a query (accuracy-critical)
RERANK_MODEL=llama-3.3-70b-versatile

# Light model: fast/cheap tasks (inference + query parsing)
LIGHT_MODEL=llama-3.1-8b-instant

# Parsing: NL query → structured filters (upgraded to 70b for reliable tool-use)
PARSING_MODEL=llama-3.3-70b-versatile

# ─── Embedding Provider ───────────────────────────────────
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3-large

# ─── Frontend ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
